{
  "name": "purplexity-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate deploy",
    "postinstall": "bun --bun prisma generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.12.21",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.104.1",
    "@tavily/core": "^0.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
