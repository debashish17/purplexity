# Copy to frontend/.env and fill in. BUN_PUBLIC_* values are inlined into the
# browser bundle, so only put public values here (never the Supabase secret key).

# Supabase: Project Settings > API
BUN_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
BUN_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, defaults to http://localhost:3001
# BUN_PUBLIC_BACKEND_URL=http://localhost:3001
